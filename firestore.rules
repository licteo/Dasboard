rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProject(project) {
      return project.name is string && project.name.size() > 0 && project.name.size() <= 100 &&
             project.description is string && project.description.size() > 0 && project.description.size() <= 500 &&
             project.url is string && project.url.size() > 0 && project.url.size() <= 1000 &&
             project.createdAt == request.time &&
             project.ownerId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidProject(request.resource.data) && (projectId == null || isValidId(projectId));
      allow update: if isSignedIn() && isOwner(resource.data.ownerId) && 
                      isValidProject(request.resource.data) &&
                      request.resource.data.ownerId == resource.data.ownerId &&
                      request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }
  }
}
