{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A developer project card",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the application"
        },
        "description": {
          "type": "string",
          "description": "Short description of the application"
        },
        "url": {
          "type": "string",
          "description": "URL to navigate to the application"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the project was added"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the user who added the project"
        }
      },
      "required": ["name", "description", "url", "createdAt", "ownerId"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of projects displayed on the dashboard"
    }
  }
}
